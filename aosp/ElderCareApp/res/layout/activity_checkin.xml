<?xml version="1.0" encoding="utf-8"?>
<!--
  Main check-in screen with a large friendly smiley face.
  The smiley pulses gently when listening.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:keepScreenOn="true">

    <!-- Centered smiley face container -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Custom smiley view will be drawn programmatically -->
        <com.eldercare.app.ui.SmileyView
            android:id="@+id/smiley_view"
            android:layout_width="300dp"
            android:layout_height="300dp" />

        <!-- Status text below smiley -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/status_ready"
            android:textSize="24sp"
            android:textColor="@color/status_text" />

    </LinearLayout>

    <!-- Listening indicator at bottom -->
    <View
        android:id="@+id/listening_indicator"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_gravity="bottom"
        android:background="@color/listening_indicator"
        android:visibility="gone" />

</FrameLayout>
