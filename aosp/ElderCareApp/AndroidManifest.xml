<?xml version="1.0" encoding="utf-8"?>
<!--
  ElderCare System App Manifest

  This app runs as a privileged system app with permissions for:
  - Audio recording and playback
  - Network access for OpenAI Realtime API and Firebase
  - Foreground service for scheduled check-ins
  - Boot completion to auto-start
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.eldercare.app"
    android:sharedUserId="android.uid.system">

    <!-- Audio permissions for voice conversations -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Network for OpenAI and Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service for scheduled check-ins -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Auto-start on boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Wake lock for scheduled tasks -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Scheduling alarms for check-ins -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:name=".ElderCareApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:persistent="true"
        android:directBootAware="true">

        <!-- Main service that handles voice check-ins -->
        <service
            android:name=".service.ElderCareService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Remote config service syncs settings from Firebase -->
        <service
            android:name=".config.RemoteConfigService"
            android:enabled="true"
            android:exported="false" />

        <!-- Boot receiver to start service on device boot -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Alarm receiver for scheduled check-ins -->
        <receiver
            android:name=".receiver.ScheduleReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Main check-in activity (fullscreen smiley face) -->
        <activity
            android:name=".ui.CheckInActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ElderCare"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Settings activity for device setup (hidden from launcher) -->
        <activity
            android:name=".ui.SetupActivity"
            android:exported="true"
            android:theme="@style/Theme.ElderCare" />

    </application>

</manifest>
